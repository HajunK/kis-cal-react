rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Kept in sync with ADMIN_EMAILS in src/core/admins.js — that list is
    // only cosmetic (shows/hides the admin nav tabs); this one is the real
    // gate.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['hajunk105@gmail.com', 'hjkim29@kis.ac'];
    }

    // Each user can only read/write their own classes and assignments.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // School-wide assessment calendar (formative/summative dates per
    // course), set by admins and read by every student to build their own
    // upcoming-assessments view. Anyone can read (not sensitive — just
    // course names and dates); only an admin email can write.
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A/B day type per date (see admin's day-type picker) — same
    // public-read/admin-write rule as assessments above.
    match /dayTypes/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The bell schedule: periodTimes/default holds every A-day/B-day's
    // start/end time per block (see SCHEDULE_BLOCKS in
    // assessments-shared.js). Read by every student to power the "time
    // left in class" pill; only an admin email can write.
    match /periodTimes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // When each school-wide collection last changed (see bumpCacheVersion in
    // assessments-admin.js): read by every page load instead of the whole
    // collections, which are fetched only when this says they've changed.
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assessments students have added themselves via My Courses' "Add
    // Missing Assessment" (see addedAssessments under users/{userId} above)
    // but that aren't yet in the admin-scheduled assessments collection —
    // tagged with the emails of everyone who suggested it, deduped by the
    // client's own {date,courseName,type} hash key (emails.length stands in
    // for a count). hasOnly below is what stops a signed-in student from
    // writing someone ELSE's email into the array, or inventing a brand new
    // one — a write may only ever add/remove its own. Deleting the whole
    // doc back out is either the admin accepting/declining it on the
    // Suggestions page (any count) or a student's own unlogSuggestedAssessment
    // cleanup, allowed only once no emails would be left — request.resource
    // is null on a delete, so this is its own rule rather than folded into
    // create/update above.
    match /suggested/{suggestionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.type in ['Summative', 'Formative', 'Reassessment']
        && request.resource.data.date is string
        && request.resource.data.courseName is string
        && request.resource.data.emails.hasOnly([request.auth.token.email]);
      allow update: if request.auth != null
        && request.resource.data.type in ['Summative', 'Formative', 'Reassessment']
        && request.resource.data.date is string
        && request.resource.data.courseName is string
        && request.resource.data.emails.hasOnly(resource.data.emails.concat([request.auth.token.email]));
      allow delete: if request.auth != null
        && (resource.data.emails.size() <= 1 || isAdmin());
    }

    // Study guides on guides.kiscal.app (guides/): the document's name is the
    // guide's key, its address (guides.kiscal.app/<key>), so it has to be
    // lowercase words joined by hyphens and can't be a name the site itself
    // uses. A published guide can be read by anyone, a draft only by an admin,
    // and only an admin can write them. (A guide that doesn't exist reads as
    // missing rather than refused.)
    match /guides/{guideId} {
      allow read: if resource == null || resource.data.published == true || isAdmin();
      allow create, update: if isAdmin()
        && guideId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && guideId.size() >= 2
        && guideId.size() <= 40
        && !(guideId in ['guide', 'index', 'js', 'icons', 'fonts'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.course is string
        && request.resource.data.published is bool
        && request.resource.data.body is string
        && request.resource.data.body.size() < 200000;
      allow delete: if isAdmin();
    }

    // Star ratings of the study guides (guides/js/rating.js). Rating takes a
    // Google sign-in, and each person has one rating per guide: the document is
    // named <guide key>__<their user id>, so there is only one, and a signed-in
    // user may create it and replace it (to change their rating) but never write
    // anyone else's or delete it. It holds the guide key, a whole number from 1 to
    // 5 and the time, nothing else. A user can read only their own; an admin
    // reads, lists and may delete any.
    match /guideRatings/{ratingId} {
      allow get: if isAdmin()
        || (request.auth != null && ratingId.matches('[a-z0-9]+(-[a-z0-9]+)*__' + request.auth.uid));
      allow list: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['guide', 'rating', 'updatedAt'])
        && request.resource.data.keys().hasAll(['guide', 'rating', 'updatedAt'])
        && request.resource.data.guide is string
        && request.resource.data.guide.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.guide.size() >= 2
        && request.resource.data.guide.size() <= 40
        && ratingId == request.resource.data.guide + '__' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.updatedAt is number;
      allow delete: if isAdmin();
    }

    // How many different browsers have read each study guide (guides/js/views.js),
    // with no sign-in. A browser adds one document per guide, named
    // <guide key>__<its random 32-character id>, holding the guide key and the
    // time; it can be added once and never changed, deleted or read back. Only an
    // admin can list them, to count them (and may delete any).
    match /guideViews/{viewId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['guide', 'at'])
        && request.resource.data.keys().hasAll(['guide', 'at'])
        && request.resource.data.guide is string
        && request.resource.data.guide.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.guide.size() >= 2
        && request.resource.data.guide.size() <= 40
        && viewId.matches('^[a-z0-9]+(-[a-z0-9]+)*__[a-f0-9]{32}$')
        && viewId.size() == request.resource.data.guide.size() + 34
        && viewId.matches('^' + request.resource.data.guide + '__.*$')
        && request.resource.data.at is number;
      allow delete: if isAdmin();
    }

    // Admin-authored posts/announcements shown on Domain, below the class
    // cards — always visible to every signed-in student, no per-user
    // dismiss. Same public-read/admin-write rule as assessments above.
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
